<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>b138a6d9-6b61-4888-b678-830024705265</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>H&amp;T Education</ProviderName>
  <DefaultLocale>vi-VN</DefaultLocale>
  <DisplayName DefaultValue="HTEdu"/>
  <Description DefaultValue="Vẽ hình, đồ thị, công thức, phiếu OMR cho giáo viên Toán – chèn thẳng vào Word, PowerPoint."/>
  <IconUrl DefaultValue="https://thnthynel-sketch.github.io/htedu/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://thnthynel-sketch.github.io/htedu/icon-64.png"/>
  <SupportUrl DefaultValue="https://thnthynel-sketch.github.io/htedu/#huong-dan"/>
  <AppDomains><AppDomain>https://thnthynel-sketch.github.io</AppDomain></AppDomains>
  <Hosts><Host Name="Document"/><Host Name="Presentation"/></Hosts>
  <DefaultSettings><SourceLocation DefaultValue="https://thnthynel-sketch.github.io/htedu/taskpane.html"/></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="HTEdu.Group"><Label resid="HTEdu.Label"/><Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                <Control xsi:type="Button" id="HTEdu.Open"><Label resid="HTEdu.Label"/><Supertip><Title resid="HTEdu.Label"/><Description resid="HTEdu.Tip"/></Supertip><Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon><Action xsi:type="ShowTaskpane"><TaskpaneId>HTEduPane</TaskpaneId><SourceLocation resid="Taskpane.Url"/></Action></Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="HTEdu.GroupP"><Label resid="HTEdu.Label"/><Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                <Control xsi:type="Button" id="HTEdu.OpenP"><Label resid="HTEdu.Label"/><Supertip><Title resid="HTEdu.Label"/><Description resid="HTEdu.Tip"/></Supertip><Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon><Action xsi:type="ShowTaskpane"><TaskpaneId>HTEduPane</TaskpaneId><SourceLocation resid="Taskpane.Url"/></Action></Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="https://thnthynel-sketch.github.io/htedu/icon-16.png"/><bt:Image id="Icon.32" DefaultValue="https://thnthynel-sketch.github.io/htedu/icon-32.png"/><bt:Image id="Icon.80" DefaultValue="https://thnthynel-sketch.github.io/htedu/icon-80.png"/></bt:Images>
      <bt:Urls><bt:Url id="Taskpane.Url" DefaultValue="https://thnthynel-sketch.github.io/htedu/taskpane.html"/></bt:Urls>
      <bt:ShortStrings><bt:String id="HTEdu.Label" DefaultValue="HTEdu"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="HTEdu.Tip" DefaultValue="Mở HTEdu: vẽ hình, đồ thị, công thức, phiếu OMR."/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
